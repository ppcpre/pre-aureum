{
  "name": "aureum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 execute aureum-db --local --file ./schema.sql",
    "db:migrate:remote": "wrangler d1 execute aureum-db --remote --file ./schema.sql"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
