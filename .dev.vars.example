# Copy this file to .dev.vars and fill in your own key.
# .dev.vars is for LOCAL development only — never commit it.
# For deployed environments use: wrangler secret put TWELVEDATA_API_KEY

TWELVEDATA_API_KEY=your-twelvedata-api-key

# Password for the single admin account (Zone Finder / Watchlist / Auto Trade).
# For deployed environments use: wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=change-me

# Admin AI Chat (/admin/chat) runs on Cloudflare Workers AI (the `AI`
# binding in wrangler.jsonc) — free within the account's daily Neuron
# allocation, no separate API key needed. See README for why (cost) and
# how to switch to Claude later if you want higher quality and are willing
# to pay per message.
